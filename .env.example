# ==============================================================
# BBC-AUTOMATIONS — Environment Variables
# Copy this file to `.env.local` and fill in the values below.
# NEVER commit `.env.local` to version control.
# ==============================================================

# --------------------------------------------------------------
# NVIDIA NIM API key
# Get one for free at: https://build.nvidia.com/
# Format: nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Used by: /api/generate-text (LLM copywriting)
#          /api/generate-images (Stable Diffusion XL image gen)
# --------------------------------------------------------------
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx

# --------------------------------------------------------------
# Vercel Blob read/write token
# Create a (free) Blob store in your Vercel dashboard:
#   Project → Storage → Create → Blob
# Vercel injects this automatically when deployed; for local dev
# copy the token from the store's ".env.local" snippet.
# Format: vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxx
# --------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# --------------------------------------------------------------
# Optional overrides
# --------------------------------------------------------------
# NVIDIA NIM base URL (OpenAI-compatible). Rarely needs changing.
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Text model. Alternatives: nvidia/nemotron-4-340b-instruct
# NVIDIA_TEXT_MODEL=nvidia/llama-3.1-405b-instruct

# Image model served at https://ai.api.nvidia.com/v1/genai/{model}
# NVIDIA_IMAGE_MODEL=stabilityai/stable-diffusion-xl
